		{
			"name": "03. Cursor-Based Pagination",
			"item": [
				{
					"name": "GET Users - Page 1 (limit=5)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Pagination meta contains next_cursor\", function () {",
									"    pm.expect(jsonData.meta).to.have.property(\"next_cursor\");",
									"    pm.expect(jsonData.meta).to.have.property(\"has_more\");",
									"    if (jsonData.meta.next_cursor) {",
									"        pm.collectionVariables.set(\"user_cursor\", jsonData.meta.next_cursor);",
									"    }",
									"});"
