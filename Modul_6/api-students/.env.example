# Konfigurasi aplikasi — salin file ini ke .env dan sesuaikan
APP_PORT=3000

# Koneksi PostgreSQL
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DB_DSN=postgres://postgres:PASSWORD@db:5432/praktikum_backend?sslmode=disable

# JWT Configuration
# WAJIB: isi dengan string acak minimal 32 karakter
# Generate contoh: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_MINIMAL_32_KARAKTER
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
