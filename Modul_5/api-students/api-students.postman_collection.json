    {
      "name": "Students",
      "item": [
        {
          "name": "GET /api/v1/students — List Mahasiswa",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/students?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "students"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Nomor halaman (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Jumlah data per halaman (default: 10, max: 100)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Cari berdasarkan nama atau NIM (opsional)",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "id",
                  "description": "Kolom pengurutan: id | nim | name | grade | created_at (default: id)",
                  "disabled": true
                },
                {
                  "key": "order",
                  "value": "asc",
                  "description": "Arah urutan: asc | desc (default: asc)",
                  "disabled": true
                },
                {
                  "key": "is_active",
                  "value": "true",
                  "description": "Filter status aktif: true | false (opsional)",
                  "disabled": true
                }
              ]
            },
            "description": "Mengambil daftar mahasiswa dengan fitur paginasi, pencarian, dan pengurutan.\n\n**Query Parameters:**\n| Parameter | Tipe | Default | Keterangan |\n|-----------|------|---------|------------|\n| page | integer | 1 | Nomor halaman |\n| limit | integer | 10 | Data per halaman (max 100) |\n| search | string | - | Cari nama/NIM |\n| sort | string | id | Kolom sort: id, nim, name, grade, created_at |\n| order | string | asc | asc atau desc |\n| is_active | boolean | - | Filter status aktif |"
          },
          "response": [
            {
              "name": "200 OK — Berhasil",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"daftar mahasiswa\",\n  \"data\": [\n    {\n      \"id\": 1,\n      \"nim\": \"2023001\",\n      \"name\": \"Budi Santoso\",\n      \"grade\": 85.5,\n      \"is_active\": true,\n      \"created_at\": \"2025-08-30T10:00:00Z\"\n    },\n    {\n      \"id\": 2,\n      \"nim\": \"2023002\",\n      \"name\": \"Siti Rahayu\",\n      \"grade\": 90.0,\n      \"is_active\": true,\n      \"created_at\": \"2025-08-30T10:05:00Z\"\n    }\n  ],\n  \"meta\": {\n    \"page\": 1,\n    \"limit\": 10,\n    \"total\": 2,\n    \"total_pages\": 1\n  }\n}"
            },
            {
              "name": "200 OK — Data Kosong",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"daftar mahasiswa\",\n  \"data\": [],\n  \"meta\": {\n    \"page\": 1,\n    \"limit\": 10,\n    \"total\": 0,\n    \"total_pages\": 0\n  }\n}"
            }
          ]
        },
        {
          "name": "POST /api/v1/students — Tambah Mahasiswa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"2023001\",\n  \"name\": \"Budi Santoso\",\n  \"grade\": 85.5,\n  \"is_active\": true\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/students",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "students"]
            },
            "description": "Menambahkan data mahasiswa baru.\n\n**Request Body (wajib semua field):**\n| Field | Tipe | Keterangan |\n|-------|------|------------|\n| nim | string | Nomor Induk Mahasiswa (unik) |\n| name | string | Nama lengkap mahasiswa |\n| grade | float | Nilai (0.00 – 100.00) |\n| is_active | boolean | Status aktif mahasiswa |"
          },
          "response": [
            {
              "name": "201 Created — Berhasil",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Location", "value": "/api/v1/students/1" }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"created\",\n  \"data\": {\n    \"id\": 1,\n    \"nim\": \"2023001\",\n    \"name\": \"Budi Santoso\",\n    \"grade\": 85.5,\n    \"is_active\": true,\n    \"created_at\": \"2025-08-30T10:00:00Z\"\n  }\n}"
            },
            {
              "name": "409 Conflict — NIM Duplikat",
              "status": "Conflict",
              "code": 409,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"NIM sudah digunakan\"\n}"
            },
            {
              "name": "415 Unsupported Media Type",
              "status": "Unsupported Media Type",
              "code": 415,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"Content-Type harus application/json\"\n}"
            },
            {
              "name": "422 Unprocessable Entity — Validasi Gagal",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"validasi gagal\",\n  \"errors\": {\n    \"nim\": \"nim wajib diisi\",\n    \"name\": \"name wajib diisi\",\n    \"is_active\": \"is_active wajib diisi (true atau false)\"\n  }\n}"
            }
